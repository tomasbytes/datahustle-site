---
// Hero drawing: gradient descent on a curved valley, computed at build time.
// The contours are real level sets of f; the path is the real iteration.
import { contourPaths, descentPath, toView } from '../lib/descent.js';

const SIZE = 1000;
const DURATION = 3200; // ms, path draw
const contours = contourPaths(SIZE);
const { line, marks } = descentPath();
const pts = line.map((p) => toView(p, SIZE));
const d = 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L');

// Arc-length fraction along the path for every iterate.
const cum = [0];
for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
const total = cum[cum.length - 1];

// The draw uses cubic-bezier(0.3, 0, 0.2, 1). Invert it so each step mark
// appears exactly when the line reaches it.
const bez = (t, a, b) => 3 * a * t * (1 - t) ** 2 + 3 * b * t * t * (1 - t) + t ** 3;
const timeAt = (progress) => {
  let lo = 0, hi = 1;
  for (let i = 0; i < 40; i++) { const m = (lo + hi) / 2; bez(m, 0, 1) < progress ? (lo = m) : (hi = m); }
  const x = (lo + hi) / 2; // curve's y at parameter m == progress; time is its x
  return bez(x, 0.3, 0.2);
};
const markViews = marks.map((m) => {
  const v = toView(m, SIZE);
  const i = line.indexOf(m);
  return { x: v[0], y: v[1], delay: Math.round(timeAt(cum[i] / total) * DURATION) };
});
const last = markViews.pop();
const end = { x: last.x, y: last.y };
const pct = (v: number) => `${((v / SIZE) * 100).toFixed(2)}%`;
---
<figure class="descent" style={`--draw:${DURATION}ms; --end-x:${pct(end.x)}; --end-y:${pct(end.y)}`}>
  <svg viewBox={`0 0 ${SIZE} ${SIZE}`} fill="none" role="img" aria-labelledby="descent-title descent-desc">
    <title id="descent-title">Gradient descent</title>
    <desc id="descent-desc">Contour lines of a curved valley. A path of steps starts far from the lowest point, drops into the valley and bends along it to the minimum, marked in blue.</desc>
    <defs><clipPath id="descent-clip"><rect width={SIZE} height={SIZE} /></clipPath></defs>
    <g class="contours" clip-path="url(#descent-clip)">
      {contours.map((c) => <path d={c} />)}
    </g>
    <path class="path" d={d} pathLength="1" />
    <g class="marks">
      {markViews.map((m) => <circle cx={m.x.toFixed(1)} cy={m.y.toFixed(1)} r="4.5" style={`--d:${m.delay}ms`} />)}
    </g>
    <line class="leader" x1={end.x} y1={end.y + 16} x2={end.x} y2={SIZE * 0.87} />
    <rect class="min" x={end.x - 9} y={end.y - 9} width="18" height="18" />
  </svg>
  <figcaption class="note">
    <span class="formula" aria-label="x sub k plus 1 equals x sub k minus eta times the gradient of f at x sub k">
      <i>x</i><sub><i>k</i>+1</sub> = <i>x</i><sub><i>k</i></sub> − <i>η</i>∇<i>f</i>(<i>x</i><sub><i>k</i></sub>)
    </span>
    <span class="muted">Gradient descent. Cauchy, 1847.</span>
  </figcaption>
</figure>
<script is:inline>
  // Hold the draw until the figure is on screen (on phones it sits below the
  // fold). Without JS the animation simply runs on load.
  (function () {
    var fig = document.currentScript.previousElementSibling;
    if (!('IntersectionObserver' in window)) return;
    var r = fig.getBoundingClientRect();
    if (r.top < innerHeight * 0.6) return;
    fig.setAttribute('data-wait', '');
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { fig.removeAttribute('data-wait'); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(fig);
  })();
</script>

<style>
  .descent { position: relative; margin: 0; width: 100%; aspect-ratio: 1; }
  svg { width: 100%; height: 100%; overflow: visible; }
  .contours path { stroke: #000; stroke-opacity: 0.3; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .path {
    stroke: #000; stroke-width: 1.5; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw var(--draw) cubic-bezier(0.3, 0, 0.2, 1) 400ms forwards;
  }
  .marks circle {
    fill: #000;
    opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.6);
    animation: mark 260ms var(--ease-out) calc(400ms + var(--d)) forwards;
  }
  .min {
    fill: var(--blue);
    opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(0.8);
    animation: mark 420ms var(--ease-out) calc(400ms + var(--draw) + 80ms) forwards;
  }
  .leader {
    stroke: #000; stroke-width: 1; vector-effect: non-scaling-stroke;
    opacity: 0; animation: fade 400ms var(--ease-out) calc(600ms + var(--draw)) forwards;
  }
  figcaption {
    position: absolute; left: min(var(--end-x), calc(100% - 14.5rem)); top: 87%;
    transform: translateX(-1px);
    padding: 0.5rem 0.625rem 0.5rem 0.75rem;
    margin-left: -0.75rem;
    background: var(--paper);
    display: grid; gap: 0.25rem;
    white-space: nowrap;
    opacity: 0; animation: fade 400ms var(--ease-out) calc(600ms + var(--draw)) forwards;
  }
  .formula { font-family: var(--math); font-size: 0.9375rem; letter-spacing: 0; }
  .formula i { font-family: 'KaTeX Math', var(--math); }
  .formula sub { font-size: 0.7em; line-height: 0; }

  .descent[data-wait] :is(.path, circle, .min, .leader), .descent[data-wait] figcaption { animation-play-state: paused; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes mark { to { opacity: 1; transform: scale(1); } }
  @keyframes fade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .path, .marks circle, .min, .leader, figcaption { animation: none; opacity: 1; transform: none; stroke-dashoffset: 0; }
  }
</style>
