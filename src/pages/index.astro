---
import Base from '../layouts/Base.astro';
import Descent from '../components/Descent.astro';
import Arrow from '../components/Arrow.astro';
import { getCollection } from 'astro:content';
import { SERVICES, STEPS, CLIENTS, FINDINGS, FOUNDERS } from '../data/site.js';
import { readFileSync } from 'node:fs';

// Size each logo by optical area rather than by a shared box, so wide
// wordmarks and compact marks carry the same visual weight.
const LOGO_AREA = 5000; // px² at 1x
const logos = CLIENTS.map((c) => {
  const png = readFileSync(`public/clients/${c.file}.png`);
  const w = png.readUInt32BE(16), h = png.readUInt32BE(20);
  const width = Math.min(Math.round(Math.sqrt(LOGO_AREA * (w / h))), 165);
  return { ...c, width, height: Math.round((width * h) / w) };
});

const posts = (await getCollection('pulse', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap grid">
      <div class="hero-text">
        <h1 id="hero-title"><span>Growth is an optimization problem.</span> <span>We find the path.</span></h1>
        <p class="lead">DataHustle is an intelligence and innovation partner for decision-makers. We build the measurement, data and AI systems that show where your business should intervene, and what each move is worth.</p>
        <a class="link" href="/contact">Request a strategy session <Arrow /></a>
      </div>
      <div class="hero-figure">
        <Descent />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="position-title">
    <div class="wrap grid">
      <h2 id="position-title" class="h section-head">Not AI as a trend. Clarity as a system.</h2>
      <div class="section-body position">
        <p class="sub statement">Most companies do not lack data. They lack a structure that turns it into decisions.</p>
        <div class="cols">
          <p>We start with how your business makes money. We map the system behind it: the channels, the data, the decisions and the people who make them. Then we find the few points where a change moves revenue.</p>
          <p>We build only what is needed to act on those points: measurement you can trust, models that answer a real question, media bought on evidence, and a way of working that keeps improving after we step back.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap grid">
      <div class="section-head">
        <h2 id="services-title" class="h">Four disciplines, one system.</h2>
        <a class="link head-link" href="/services">All services <Arrow /></a>
      </div>
      <ul class="section-body services">
        {SERVICES.map((s) => (
          <li>
            <a class="service" href={`/services#${s.id}`}>
              <h3 class="sub">{s.title}</h3>
              <p class="question">{s.question}</p>
              <ul class="deliverables">
                {s.deliverables.map((d) => <li>{d}</li>)}
              </ul>
              <Arrow class="arrow service-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="method-title">
    <div class="wrap grid">
      <div class="section-head">
        <h2 id="method-title" class="h">How we work: one step at a time.</h2>
        <p class="note muted head-note">[TO CONFIRM] Step names and wording.</p>
      </div>
      <ol class="section-body steps">
        {STEPS.map((s, i) => (
          <li class="step">
            <span class="k note" aria-hidden="true"><span><i>k</i> = {i + 1}</span></span>
            <h3 class="sub">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="clients-title">
    <div class="wrap grid">
      <h2 id="clients-title" class="h section-head">Selected clients</h2>
      <ul class="section-body clients">
        {logos.map((c) => (
          <li><img src={`/clients/${c.file}.png`} alt={c.name} width={c.width} height={c.height} decoding="async" /></li>
        ))}
        {Array.from({ length: (4 - (CLIENTS.length % 4)) % 4 }, () => <li class="filler" aria-hidden="true"></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="findings-title">
    <div class="wrap grid">
      <div class="section-head">
        <h2 id="findings-title" class="h">Findings</h2>
        <p class="muted head-note">Selected engagements. Client names withheld.</p>
      </div>
      <ol class="section-body findings">
        {FINDINGS.map((f, i) => (
          <li class="finding">
            <p class="sub f-sector">{f.sector}</p>
            <dl>
              <div><dt class="note muted">Challenge</dt><dd>{f.challenge}</dd></div>
              <div><dt class="note muted">Intervention</dt><dd>{f.intervention}</dd></div>
              <div><dt class="note muted">Outcome</dt><dd>{f.outcome}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="people-title">
    <div class="wrap grid">
      <h2 id="people-title" class="h section-head">The people you work with.</h2>
      <ul class="section-body people">
        {FOUNDERS.map((p) => (
          <li class="person">
            <div class="portrait" aria-hidden="true"><span class="note muted">Photo</span></div>
            <h3 class="sub">{p.name}</h3>
            <p class="muted">{p.title}</p>
            <p class="cred">{p.credentials}</p>
            <p class="muted">{p.focus}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" aria-labelledby="pulse-title">
      <div class="wrap grid">
        <div class="section-head">
          <h2 id="pulse-title" class="h">Pulse</h2>
          <a class="link head-link" href="/pulse">All articles <Arrow /></a>
        </div>
        <ul class="section-body posts">
          {posts.map((p) => (
            <li>
              <a class="post" href={`/pulse/${p.id}`}>
                <time class="note muted" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}{p.data.placeholder && <><br />Placeholder [TO CONFIRM]</>}</time>
                <h3 class="sub">{p.data.title}</h3>
                <p class="muted">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section close" aria-labelledby="close-title">
    <div class="wrap grid">
      <div class="close-mark" aria-hidden="true">
        <svg viewBox="0 0 120 24" fill="none">
          <path d="M1 12H119" stroke="#000" stroke-opacity=".3" />
          {[0, 44, 72, 88, 97, 102].map((x) => <circle cx={x + 6} cy="12" r="2.5" fill="#000" />)}
          <rect x="108" y="6.5" width="11" height="11" fill="#3335ff" />
        </svg>
      </div>
      <div class="close-body">
        <h2 id="close-title" class="h">Start with one conversation.</h2>
        <p class="lead">Tell us what you are trying to solve. We reply within two working days with a proposed agenda for a strategy session. <span class="muted">[TO CONFIRM]</span></p>
        <a class="link" href="/contact">Request a strategy session <Arrow /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* First viewport */
  .hero .grid {
    min-height: calc(100svh - 4.5rem);
    align-items: center;
    padding-block: clamp(2rem, 5vh, 4rem) clamp(3rem, 8vh, 6rem);
  }
  .hero-text { grid-column: 1 / span 6; display: grid; gap: 1.75rem; justify-items: start; align-self: center; }
  h1 {
    font-size: var(--display);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  h1 span { display: block; text-wrap: balance; }
  .lead { max-width: 30rem; }
  .hero-figure { grid-column: 7 / -1; align-self: center; padding: 0 0 3.5rem clamp(0rem, 2vw, 2rem); }

  /* Position */
  .position { display: grid; gap: 2rem; }
  .statement { max-width: 28ch; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap) calc(var(--gap) * 2); }
  .cols p { max-width: 36em; }

  .head-link { margin-top: 1.5rem; }
  .head-note { margin-top: 1rem; max-width: 30ch; }

  /* Services: ruled rows, not cards */
  .services > li { border-bottom: 1px solid var(--rule); }
  .services > li:first-child .service { padding-top: 0.25rem; }
  .service {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) 1.5rem;
    column-gap: var(--gap);
    row-gap: 0.5rem;
    padding: 1.5rem 0 1.75rem;
  }
  .service h3 { grid-column: 1; transition: color 180ms var(--ease); }
  .question { grid-column: 1; color: var(--ink-2); }
  .deliverables { grid-column: 2; grid-row: 1 / span 2; display: grid; gap: 0.375rem; }
  .deliverables li { padding-left: 1rem; position: relative; }
  .deliverables li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 5px; height: 5px; background: #000; }
  :global(.service-arrow) { grid-column: 3; grid-row: 1; width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; transition: transform 220ms var(--ease-out), color 180ms var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .service:hover h3, .service:hover :global(.service-arrow) { color: var(--blue); }
    .service:hover :global(.service-arrow) { transform: translateX(4px); }
  }

  /* Method: iterations k = 1..4 */
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gap); }
  .step { display: grid; align-content: start; gap: 0.625rem; position: relative; }
  .k { display: flex; align-items: center; gap: 0.5rem; }
  .k::before { content: ''; width: 7px; height: 7px; background: #000; flex: none; }
  .k { font-family: var(--math); font-size: 0.875rem; }
  .k i { font-family: 'KaTeX Math', var(--math); }
  .step p { max-width: 26ch; }

  /* Clients: a ruled index of equal cells */
  .clients {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    margin-top: -1.25rem; /* the grid starts on the section rule */
    border-left: 1px solid var(--rule);
  }
  .clients li {
    display: grid; place-items: center;
    aspect-ratio: 16 / 9;
    padding: 1.25rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .clients img { max-width: 80%; height: auto; max-height: 3.5rem; object-fit: contain; }

  /* Findings */
  .finding:first-child { padding-top: 0.25rem; }
  .finding {
    display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    column-gap: var(--gap);
    padding: 1.5rem 0 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .finding dl { display: grid; gap: 0.875rem; }
  .finding dl div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--gap); }
  .finding dt { padding-top: 0.2rem; }

  /* People */
  .people { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap) calc(var(--gap) * 2); }
  .person { display: grid; align-content: start; gap: 0.375rem; }
  .portrait {
    aspect-ratio: 4 / 5; max-width: 16rem; margin-bottom: 1rem;
    border: 1px solid var(--rule);
    display: grid; place-items: end start; padding: 0.625rem;
  }
  .cred { margin-top: 0.625rem; max-width: 34ch; }

  /* Pulse */
  .posts > li { border-bottom: 1px solid var(--rule); }
  .posts > li:first-child .post { padding-top: 0.25rem; }
  .post { display: grid; grid-template-columns: 10rem minmax(0, 1fr); column-gap: var(--gap); row-gap: 0.5rem; padding: 1.5rem 0 1.75rem; }
  .post time { grid-row: 1 / span 2; padding-top: 0.35rem; }
  .post h3 { transition: color 180ms var(--ease); }
  .post p { max-width: 60ch; }
  @media (hover: hover) and (pointer: fine) {
    .post:hover h3 { color: var(--blue); }
  }

  /* Close */
  .close .grid { align-items: start; }
  .close-mark { grid-column: 1 / span 4; padding-top: 0.5rem; }
  .close-mark svg { width: 8rem; height: auto; }
  .close-body { grid-column: 5 / -1; display: grid; gap: 1.5rem; justify-items: start; }

  @media (max-width: 60rem) {
    .hero .grid { min-height: 0; padding-top: 2.5rem; row-gap: 2.5rem; }
    .hero-text, .hero-figure { grid-column: 1 / -1; }
    .hero-figure { padding: 0 0 3.5rem; max-width: 36rem; width: 100%; justify-self: center; }
    .cols { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
    .clients { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 0; border-top: 1px solid var(--rule); }
    .clients li { aspect-ratio: 3 / 2; padding: 1rem; }
    .clients img { max-width: 85%; max-height: 2.75rem; }
    .close-mark { display: none; }
    .close-body { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .service { grid-template-columns: minmax(0, 1fr) 1.5rem; }
    .deliverables { grid-column: 1; grid-row: auto; margin-top: 0.5rem; }
    :global(.service-arrow) { grid-column: 2; }
    .steps { grid-template-columns: 1fr; }
    .finding { grid-template-columns: 1fr; row-gap: 1rem; }
    .finding dl div { grid-template-columns: 1fr; gap: 0.25rem; }
    .people { grid-template-columns: 1fr; row-gap: 3rem; }
    .post { grid-template-columns: 1fr; }
    .post time { grid-row: auto; padding: 0; }
  }
</style>
