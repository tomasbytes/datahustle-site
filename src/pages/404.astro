---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found">
  <PageHead title="This page does not exist." intro="The link may be out of date, or the address mistyped.">
    <p class="back"><a class="link" href="/">Back to the homepage <Arrow /></a></p>
  </PageHead>
</Base>
<style>
  .back { grid-column: 8 / -1; }
  @media (max-width: 60rem) { .back { grid-column: 1 / -1; } }
</style>
