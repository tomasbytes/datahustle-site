---
// Hero instrument: the contour map of f with a live gradient descent.
// Build time: contour lines and the default path (also the no-JS fallback).
// Browser (src/scripts/instrument.ts): canvas rendering, cursor readout,
// click-to-descend, and the scroll tilt into a 3D wireframe.
import { contourLines, defaultPath, toPathD } from '../lib/descent.js';

const SIZE = 1000;
const lines = contourLines();
const path = defaultPath();
const end = path[path.length - 1];
const k = Math.max(1, Math.round((path.length - 1) / 20));
const marks = path.filter((_, i) => i % k === 0 && i < path.length - 1);
const data = JSON.stringify({ lines, end });
---
<figure class="instrument" data-instrument data-end-u={end[0]} data-end-v={end[1]}>
  <div class="stage" data-stage>
    <svg class="fallback" viewBox={`0 0 ${SIZE} ${SIZE}`} fill="none" role="img" aria-labelledby="inst-title inst-desc">
      <title id="inst-title">Gradient descent on a curved valley</title>
      <desc id="inst-desc">Contour lines of a curved valley. A path of steps starts far from the lowest point, drops into the valley and bends along it to the minimum, marked in blue.</desc>
      <g class="fb-contours">
        {lines.flatMap((l) => l.lines).map((ln) => <path d={toPathD(ln, SIZE)} />)}
      </g>
      <path class="fb-path" d={toPathD(path, SIZE)} />
      <g class="fb-marks">{marks.map(([u, v]) => <circle cx={(u * SIZE).toFixed(1)} cy={(v * SIZE).toFixed(1)} r="4.5" />)}</g>
      <rect class="fb-min" x={end[0] * SIZE - 9} y={end[1] * SIZE - 9} width="18" height="18" />
    </svg>
    <canvas data-canvas aria-hidden="true"></canvas>
    <div class="readout" data-readout aria-hidden="true" hidden></div>
  </div>
  <figcaption class="panel">
    <p class="hint note" data-hint>Pick a starting point.</p>
    <p class="counter mono" aria-live="off">
      <span><i>k</i> = <span data-k>0</span></span>
      <span><i>f</i>(<i>x</i><sub><i>k</i></sub>) = <span data-loss>0.0000</span></span>
    </p>
    <p class="formula note muted">
      <span class="math" aria-label="x sub k plus 1 equals x sub k minus eta times the gradient of f at x sub k"><i>x</i><sub><i>k</i>+1</sub> = <i>x</i><sub><i>k</i></sub> − <i>η</i>∇<i>f</i>(<i>x</i><sub><i>k</i></sub>)</span>
      <span>Gradient descent. Cauchy, 1847.</span>
    </p>
  </figcaption>
  <script type="application/json" data-instrument-data set:html={data} />
</figure>

<script>
  import { mountInstrument } from '../scripts/instrument';
  document.querySelectorAll<HTMLElement>('[data-instrument]').forEach(mountInstrument);
</script>

<style>
  .instrument { margin: 0; display: grid; gap: 1rem; }
  .stage { position: relative; aspect-ratio: 1; width: 100%; touch-action: pan-y; }
  .fallback, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { display: none; cursor: crosshair; }
  :global(html.js) .instrument canvas { display: block; }
  :global(html.js) .instrument .fallback { display: none; }
  .fb-contours path { stroke: #000; stroke-opacity: 0.3; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fb-path { stroke: #000; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .fb-marks circle { fill: #000; }
  .fb-min { fill: var(--blue); }

  .readout {
    position: absolute; left: 0; top: 0; z-index: 2;
    pointer-events: none;
    font: 400 0.75rem/1.35 var(--mono);
    letter-spacing: 0;
    white-space: pre;
    background: var(--paper);
    padding: 0.25rem 0.375rem;
    border: 1px solid var(--black);
    will-change: transform;
  }

  .panel {
    display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--black); padding-top: 0.625rem;
  }
  .hint { font-weight: 600; }
  .counter { display: flex; gap: 1.5rem; justify-self: end; font-size: 0.8125rem; }
  .counter i, .formula i { font-family: 'KaTeX Math', var(--math); font-size: 1.05em; }
  .counter span span { font-variant-numeric: tabular-nums; }
  .formula { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
  .math { font-family: var(--math); font-size: 0.875rem; color: var(--black); }
  sub { font-size: 0.7em; line-height: 0; }
  @media (max-width: 40rem) {
    .panel { grid-template-columns: 1fr; }
    .counter { justify-self: start; }
  }
</style>
