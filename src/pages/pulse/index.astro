---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('pulse', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Pulse" description="Notes from DataHustle on measurement, data, AI and the decisions they should inform.">
  <PageHead title="Pulse" intro="Notes on measurement, data, AI and the decisions they should inform." />
  <div class="wrap">
    {posts.length ? (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a class="post" href={`/pulse/${p.id}`}>
              <time class="note muted" datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}{p.data.placeholder && <><br />Placeholder [TO CONFIRM]</>}</time>
              <h2 class="sub">{p.data.title}</h2>
              <p class="muted">{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty muted">No articles yet.</p>
    )}
  </div>
</Base>

<style>
  .posts { border-top: 1px solid var(--black); }
  .posts > li { border-bottom: 1px solid var(--rule); }
  .post {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 0.5rem;
    padding: 1.75rem 0 2rem;
  }
  .post time { grid-column: 1 / span 4; grid-row: 1 / span 2; padding-top: 0.35rem; }
  .post h2, .post p { grid-column: 5 / -1; }
  .post h2 { transition: color 180ms var(--ease); max-width: 36ch; }
  .post p { max-width: 60ch; }
  @media (hover: hover) and (pointer: fine) { .post:hover h2 { color: var(--blue); } }
  .empty { padding-block: 2rem; border-top: 1px solid var(--black); }
  @media (max-width: 60rem) {
    .post time, .post h2, .post p { grid-column: 1 / -1; grid-row: auto; }
  }
</style>
